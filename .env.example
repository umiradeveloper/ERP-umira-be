# Koneksi MySQL 8+
DATABASE_URL="mysql://root:password@localhost:3306/erp_kontraktor"

# Ganti dengan string acak panjang di production (simpan di secret manager)
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-access"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-refresh"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=7

PORT=4000
# Batas ukuran body JSON (impor Excel RAB/RAP/BQ besar). Default 20mb
BODY_LIMIT=20mb
WEB_ORIGIN="http://localhost:3000"

# Penyimpanan lampiran
UPLOAD_DIR="./uploads"

# Email notifikasi (opsional — kosongkan untuk menonaktifkan)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ERP Umira <no-reply@perusahaan.co.id>"

# Push notification aplikasi mobile (Firebase Cloud Messaging) — opsional.
# Isi path ke file service account dari Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT=""

# Sumber data vendor (supplier) dari endpoint eksternal — Basic Auth.
# Kosongkan VENDOR_SOURCE_URL untuk menonaktifkan; vendor tetap bisa diinput manual/Excel.
VENDOR_SOURCE_URL=""
VENDOR_SOURCE_USER=""
VENDOR_SOURCE_PASSWORD=""
# Lokasi array vendor di JSON respons, mis. "data" atau "data.items" (kosong = deteksi otomatis)
VENDOR_SOURCE_LIST_PATH=""
# Pemetaan field (opsional), mis. {"code":"vendor_code","name":"vendor_name","taxNumber":"npwp","phone":"no_telp","paymentTerm":"top"}
VENDOR_FIELD_MAP=""
# Sinkron otomatis terjadwal (opsional): slug perusahaan + interval menit
VENDOR_SYNC_TENANT=""
VENDOR_SYNC_INTERVAL_MIN=0
# "false" = vendor hanya dari endpoint (tambah/ubah manual & impor Excel dimatikan)
VENDOR_MANUAL_INPUT=true

# ── Akun dari SuperApps ─────────────────────────────────────────────
# User login ke ERP memakai akun SuperApps (email/username + password SuperApps).
# Gunakan user database yang HANYA punya hak SELECT pada tabel users & role.
SUPERAPPS_DATABASE_URL=""
# Slug perusahaan ERP yang memakai akun SuperApps (buat dulu: npm run tenant:create -- --slug umira --name "PT Umira Sinergi Global")
SUPERAPPS_TENANT=""
# Pemetaan role SuperApps → role ERP (default: ./superapps-role-map.json)
SUPERAPPS_ROLE_MAP_FILE="superapps-role-map.json"
# Sinkron user otomatis tiap N menit (0 = hanya saat login & tombol Sinkron)
SUPERAPPS_SYNC_INTERVAL_MIN=0
# Perusahaan default saat kolom "Kode perusahaan" tidak diisi (opsional; default = SUPERAPPS_TENANT)
DEFAULT_TENANT=""

# Tampilkan tombol akun demo (perusahaan "demo", password Password123!) di halaman login: true / false
SHOW_DEMO=false
